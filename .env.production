# Base path used by Vite when building for GitHub Pages.
# Repo is VrushalNanavati/Portfolio -> project site at https://vrushalnanavati.github.io/Portfolio/
# CI derives this automatically from the repository name; this value is for local `npm run build`
# and `npm run deploy`. Set to "/" if you move to a <user>.github.io repo or a custom domain.
VITE_BASE_PATH=/Portfolio/
